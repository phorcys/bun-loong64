+/* push a reference to a single-argument helper function with a real prototype.
+   This is required on hard-float targets: old-style function calls treat float
+   arguments as variadic and pass them in integer registers. */
+static void vpush_typed_helper_func1(int v, int ret_t, int arg_t)
+{
+    CType ret_type, arg_type, func_type;
+    Sym *func_proto, *arg;
+
+    ret_type.t = ret_t;
+    ret_type.ref = NULL;
+    arg_type.t = arg_t;
+    arg_type.ref = NULL;
+
+    func_proto = sym_push(SYM_FIELD, &ret_type, 0, 0);
+    func_proto->f.func_call = FUNC_CDECL;
+    func_proto->f.func_type = FUNC_NEW;
+    arg = sym_push(SYM_FIELD, &arg_type, 0, 0);
+    func_proto->next = arg;
+
+    func_type.t = VT_FUNC;
+    func_type.ref = func_proto;
+    vpushsym(&func_type, external_helper_sym(v));
+}
